# ==============================================================================
# DBT-GUARD SMS GATEWAY CONFIGURATION (.env)
# ==============================================================================
# Add these variables to your Vercel Project Settings > Environment Variables:
# https://vercel.com/dashboard -> Your Project -> Settings -> Environment Variables

# --- Option A: Twilio SMS Cloud Sandbox ---
# Sign up at https://www.twilio.com/try-twilio
# Verified numbers can receive SMS in trial mode
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# --- Option B: Vonage (Nexmo) Messaging API ---
# Sign up at https://developer.vonage.com/
VONAGE_API_KEY=your_vonage_api_key_here
VONAGE_API_SECRET=your_vonage_api_secret_here
VONAGE_FROM_NUMBER=DBTGUARD

# --- Option C: TextBee.dev Android Gateway (Client-side / Direct) ---
# Sign up at https://textbee.dev
# Free 300 SMS/month sent via Android phone SIM card
VITE_TEXTBEE_API_KEY=
VITE_TEXTBEE_DEVICE_ID=

# --- Google Gemini AI API Key ---
# Powers bilingual Malayalam/English farmer SMS drafting & voice assist IVR
# Get your free key at https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

